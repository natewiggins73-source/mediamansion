  leafMark=L.marker([lat,lon]).addTo(leafMap).bindPopup(label,{maxWidth:220}).openPopup();
  leafMap.setView([lat,lon],17);
  document.getElementById('map-wrap').classList.add('visible');
  document.getElementById('map-note').style.display='block';
  document.getElementById('map-na').style.display='none';
  setTimeout(()=>leafMap.invalidateSize(),120);
  checkTravelFee(lat,lon);
}

// ============================================================
// OSRM TRAVEL DISTANCE CHECK (from Manayunk, Philadelphia PA)
// ============================================================
const ORIGIN_LAT=40.0247, ORIGIN_LON=-75.2271; // Manayunk, Philadelphia
const TRAVEL_FREE_MILES=30;            // free zone: within 30 miles ...
const TRAVEL_FREE_SEC=2700;            // ... or about 45 minutes, whichever is exceeded first
const TRAVEL_RATE_PER_MILE=1.25;       // charged on the full one-way distance — no credit, no discount
const TRAVEL_MAX_SEC=16200;            // 4.5 hours — outside service range

function calcTravelFeeAmount(miles){
  return Math.ceil((miles*TRAVEL_RATE_PER_MILE)/5)*5; // rounded up to nearest $5
}

function checkTravelFee(destLat,destLon){
  fetch(`https://router.project-osrm.org/route/v1/driving/${ORIGIN_LON},${ORIGIN_LAT};${destLon},${destLat}?overview=false`,{headers:{'Accept-Language':'en'}})
    .then(r=>r.json())
    .then(data=>{
      if(!data.routes||!data.routes.length) return;
      const route=data.routes[0];
      const miles=Math.ceil(route.distance/1609.34);
      const banner=document.getElementById('travel-fee-banner');
      const outsideBanner=document.getElementById('travel-outside-banner');

      if(route.duration>TRAVEL_MAX_SEC){
        // Outside service range
        S.travelMiles=0; S.travelFee=0;
        if(banner) banner.classList.remove('show');
        if(outsideBanner){
          outsideBanner.innerHTML=`&#x1F4CD; <strong>We're sorry, but this address is outside of our service range at this time.</strong> We're always working to expand the areas we cover, so check back soon!
            <label class="check-wrap"><input type="checkbox" id="travel-notify-cb" onchange="S.travelNotify=this.checked"><span>Please check this box if you'd like to be notified in the future if we're able to service this area.</span></label>`;
          outsideBanner.classList.add('show');
        }
      } else if(route.duration>TRAVEL_FREE_SEC || miles>TRAVEL_FREE_MILES){
        // Within range but travel fee applies
        const fee=calcTravelFeeAmount(miles);
        S.travelMiles=miles; S.travelFee=fee;
        if(banner){banner.innerHTML=`&#x1F4CD; <strong>This address is about ${miles} miles from us &mdash; a travel fee of $${fee} has been added.</strong> Travel is free within ${TRAVEL_FREE_MILES} miles; beyond that it's $${TRAVEL_RATE_PER_MILE.toFixed(2)} per one-way mile. The fee appears in your order summary and on your invoice.`;banner.classList.add('show');}
        if(outsideBanner) outsideBanner.classList.remove('show');
      } else {
        S.travelMiles=0; S.travelFee=0;
        if(banner) banner.classList.remove('show');
        if(outsideBanner) outsideBanner.classList.remove('show');
      }
      render();
    })
    .catch(err=>{ console.error('Travel fee check failed:',err); }); // OSRM unavailable — no fee applied, but logged for debugging
}

