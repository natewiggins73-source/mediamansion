// ============================================================
// CALC TOTAL
// ============================================================
function calcTotal(){
  const items=[], key=S.sqftKey;

  const PKG_DESC = {
    ess:'Essential Photos Package (30 Photos + Floor Plan + Property Website)',
    escan:'Essential Scan Package (3D Matterport Scan + 5 Exterior 360s, 90-day hosting)',
    sig:'Premier Combo Package (35 Photos + Floor Plan + Matterport 3D Tour + Property Website, 90-day hosting)',
    del:'Deluxe Bundle Package (35 Photos + Floor Plan + Matterport 3D Tour + Property Website + Social Media Kit + 2 Virtual Dusk Photos + 1 Vertical Property Walkthrough Reel, 90-day hosting)',
  };
  if(S.pkg&&key){
    const price = PKG[S.pkg][key];
    if(price==null) items.push({n:PKG_DESC[S.pkg]+' &mdash; 8,001+ sq ft',p:0,label:'Custom Quote'});
    else {
      items.push({n:PKG_DESC[S.pkg],p:price});
      if(S.essAddon&&S.pkg!=='escan') items.push({n:`Add 15 Photos (${S.pkg==='ess'?45:50} total)`,p:75,a:true});
    }
  }

  if(S.photos&&key){
    const pinfo = pkgPhotoInfo();
    const pPrice = PHOTO_PRICE[S.photos.c][key];
    items.push({n: pinfo ? `${S.photos.c} Additional Photos (beyond ${pinfo.name} package)` : `${S.photos.c} Photos (Listing)`, p:pPrice});
  }

  if(!pkgHasKit()&&S.photoKit) items.push({n:'Social Media Kit & Property Website',p:PRICE.kitBundle});

  const haveKitForCalc = pkgHasKit()||S.photoKit;
  const haveWebsiteForCalc = pkgHasWebsite()||S.photoKit;
  if(S.mktOption==='kit'&&!haveKitForCalc) items.push({n:'Social Media Kit',p:PRICE.kit});
  else if(S.mktOption==='website'&&!haveWebsiteForCalc) items.push({n:'Property Website',p:PRICE.website});
  else if(S.mktOption==='bundle'&&!(haveKitForCalc&&haveWebsiteForCalc)) items.push({n:'Social Media Kit & Property Website',p:PRICE.kitBundle});

  if(S.vvt&&key){
    items.push({n:'Simple Walk-Through Video (30&ndash;60 Sec)',p:VVT_PRICE[key]});
    if(S.vvtFmt==='Both') items.push({n:'Vertical + Horizontal cuts',p:VVT_BOTH_FMT_FEE,a:true});
  }
  if(S.vidCine&&key&&FWV_PRICE[key]) items.push({n:'Full Walkthrough Video',p:FWV_PRICE[key]});
  if(S.vidLargeInterest) items.push({n:'Full Walkthrough Video &mdash; 8,001+ sq ft',p:0,label:'Custom Quote'});

  if(S.rush) items.push({n:'Rush Delivery (Under 24 Hours)',p:PRICE.rush});
  if(S.holiday) items.push({n:'Holiday Booking',p:PRICE.holiday});

  if(S.fp) items.push({n:'Floor Plans',p:PRICE.fp});
  if(S.matterpak) items.push({n:'MatterPak Bundle',p:PRICE.matterpak});
  if(S.e57) items.push({n:'E57 Point Cloud Export',p:PRICE.e57});
  if(S.cad) items.push({n:'CAD File (DWG/DXF)',p:PRICE.cad,label:'Starting at '+fmt(PRICE.cad)});
  if(S.bim) items.push({n:'BIM File (Revit/IFC)',p:PRICE.bim,label:'Starting at '+fmt(PRICE.bim)});
  if(S.trueplan) items.push({n:'TruePlan (Xactimate Sketch File)',p:PRICE.trueplan,label:'Starting at '+fmt(PRICE.trueplan)});
  if(S.pireport) items.push({n:'Property Intelligence Report',p:PRICE.pireport});
  if(S.vdusk) items.push({n:`Virtual Dusk &times; ${S.vduskQty}`,p:S.vduskQty*PRICE.vdusk});
  if(S.stageOnly) items.push({n:`Virtual Staging &times; ${S.stageOnlyQty} image${S.stageOnlyQty>1?'s':''}`,p:S.stageOnlyQty*PRICE.stage});
  if(S.clutterOnly) items.push({n:`Clutter Removal &times; ${S.clutterOnlyQty} image${S.clutterOnlyQty>1?'s':''}`,p:S.clutterOnlyQty*PRICE.clutter});
  if(S.stageClutter) items.push({n:`Virtual Staging + Clutter Removal &times; ${S.stageClutterQty} image${S.stageClutterQty>1?'s':''}`,p:S.stageClutterQty*PRICE.stageClutter});
  if(S.videdit==='short60') items.push({n:'Video Editing (Up to 60 Seconds)',p:PRICE.videdit.short60});
  else if(S.videdit==='1to3') items.push({n:'Video Editing (1&ndash;3 Minutes)',p:PRICE.videdit['1to3']});
  else if(S.videdit==='4to10') items.push({n:'Video Editing (4&ndash;10 Minutes)',p:PRICE.videdit['4to10'],label:'Starting at '+fmt(PRICE.videdit['4to10'])});
  if(S.giftSig) items.push({n:'The Signature Album',p:PRICE.album});
  if(S.travelFee>0) items.push({n:`Travel Fee (${S.travelMiles} mi one-way)`,p:S.travelFee});

  return {items, total:items.reduce((s,i)=>s+i.p,0)};
}

// ============================================================
// CALC TIME ESTIMATE
// ============================================================
function calcTime(){
  const key=S.sqftKey; if(!key) return null;
  let mn=0, mx=0;
  if(S.pkg==='ess'&&T.ess[key]){mn+=T.ess[key][0];mx+=T.ess[key][1];}
  else if(S.pkg==='escan'&&T.escan[key]){mn+=T.escan[key][0];mx+=T.escan[key][1];}
  else if(S.pkg==='del'&&T.del[key]){mn+=T.del[key][0];mx+=T.del[key][1];}
  else if(S.pkg==='sig'&&T.sig[key]){mn+=T.sig[key][0];mx+=T.sig[key][1];}
  else if(S.photos&&T.photo[key]){mn+=T.photo[key][0];mx+=T.photo[key][1];}
  if(S.vvt){mn+=0.5;mx+=0.5;}
  if(S.vidCine||S.vidLargeInterest){mn+=1.5;mx+=1.5;}
  if(mn===0&&mx===0) return null;
  return fmtH(mn)+' &ndash; '+fmtH(mx);
}

