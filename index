function handleSubmit(){
  const sb=document.getElementById('submit-sb');
  if(sb&&sb.classList.contains('submit-locked')){
    showToast('Please complete all sections before submitting.','err');
    return;
  }
  const errs=collectErrors();
  if(errs.length===0){ doSubmit(); return; }
  // Cycle to next error
  if(errIdx>=errs.length) errIdx=0;
  const el=errs[errIdx];
  el.scrollIntoView({behavior:'smooth',block:'center'});
  if(el.focus) try{el.focus();}catch(e){}
  errIdx++;
  if(errIdx>=errs.length) errIdx=0;
}

['submit-sb','submit-mob'].forEach(id=>{const b=document.getElementById(id);if(b)b.addEventListener('click',handleSubmit);});
// Reset error cycling when user makes changes
document.addEventListener('change',()=>{errIdx=0;});
document.addEventListener('input',()=>{errIdx=0;});

// ============================================================
// INIT
// ============================================================
render();
</script>
