// NOMINATIM AUTOCOMPLETE
// ============================================================
const SA={'Alabama':'AL','Alaska':'AK','Arizona':'AZ','Arkansas':'AR','California':'CA','Colorado':'CO','Connecticut':'CT','Delaware':'DE','Florida':'FL','Georgia':'GA','Hawaii':'HI','Idaho':'ID','Illinois':'IL','Indiana':'IN','Iowa':'IA','Kansas':'KS','Kentucky':'KY','Louisiana':'LA','Maine':'ME','Maryland':'MD','Massachusetts':'MA','Michigan':'MI','Minnesota':'MN','Mississippi':'MS','Missouri':'MO','Montana':'MT','Nebraska':'NE','Nevada':'NV','New Hampshire':'NH','New Jersey':'NJ','New Mexico':'NM','New York':'NY','North Carolina':'NC','North Dakota':'ND','Ohio':'OH','Oklahoma':'OK','Oregon':'OR','Pennsylvania':'PA','Rhode Island':'RI','South Carolina':'SC','South Dakota':'SD','Tennessee':'TN','Texas':'TX','Utah':'UT','Vermont':'VT','Virginia':'VA','Washington':'WA','West Virginia':'WV','Wisconsin':'WI','Wyoming':'WY'};
let acTimer=null, acRes=[];
const addrInp=document.getElementById('addr1'), addrDrop=document.getElementById('addr-drop');
addrInp.addEventListener('input',function(){
  clearTimeout(acTimer);
  const q=this.value.trim();
  if(q.length<4){addrDrop.classList.remove('open');return;}
  acTimer=setTimeout(async()=>{
    try{
      const r=await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=5&countrycodes=us&addressdetails=1&q=${encodeURIComponent(q+' USA')}`,{headers:{'Accept-Language':'en'}});
      acRes=await r.json();
      if(!acRes.length){addrDrop.classList.remove('open');return;}
      addrDrop.innerHTML=acRes.map((res,i)=>{
        const a=res.address||{};
        const road=(a.house_number?a.house_number+' ':'')+(a.road||'');
        const sub=`${a.city||a.town||a.village||''}, ${a.state||''} ${a.postcode||''}`.replace(/^,\s*/,'').trim();
        return `<div class="addr-item" data-i="${i}"><div class="addr-item-main">${road||res.display_name.split(',')[0]}</div><div class="addr-item-sub">${sub}</div></div>`;
      }).join('');
      addrDrop.classList.add('open');
    }catch(e){addrDrop.classList.remove('open');}
  },450);
});
addrDrop.addEventListener('click',function(e){
  const item=e.target.closest('.addr-item');if(!item)return;
  const r=acRes[parseInt(item.dataset.i)];if(!r)return;
  const a=r.address||{};
  const road=(a.house_number?a.house_number+' ':'')+(a.road||'');
  if(road)addrInp.value=road;
  if(a.city||a.town||a.village)document.getElementById('city').value=a.city||a.town||a.village;
  if(a.state){const abbr=SA[a.state]||a.state;const sel=document.getElementById('state');for(let i=0;i<sel.options.length;i++){if(sel.options[i].value===abbr){sel.selectedIndex=i;break;}}}
  if(a.postcode)document.getElementById('zip').value=a.postcode.substring(0,5);
  addrDrop.classList.remove('open');addrDrop.innerHTML='';
  setTimeout(()=>geocodeAndPin(),100);
});
document.addEventListener('click',e=>{if(!e.target.closest('.addr-wrap'))addrDrop.classList.remove('open');});

// ============================================================
// VALIDATION + CYCLING ERROR QUEUE
// ============================================================
let errQueue=[], errIdx=0;

function collectErrors(){
  const errs=[];
  function add(test,inpId,errId,secId){
    if(!test){
      const el=document.getElementById(inpId); const sec=document.getElementById(secId);
      if(el)el.classList.add('err'); const ee=document.getElementById(errId); if(ee)ee.classList.add('show');
      errs.push(el||sec||document.getElementById(errId));
    } else {
      const el=document.getElementById(inpId); if(el)el.classList.remove('err');
      const ee=document.getElementById(errId); if(ee)ee.classList.remove('show');
    }
  }
  // Sqft
  if(!S.sqftKey){document.getElementById('sqft-error').classList.add('show');errs.push(document.getElementById('sec1'));}
  else{document.getElementById('sqft-error').classList.remove('show');}
  // Property info
  add(document.getElementById('addr1').value.trim(),'addr1','addr1-err','sec12');
  add(document.getElementById('city').value.trim(),'city','city-err','sec12');
  add(document.getElementById('state').value,'state','state-err','sec12');
  add(/^\d{5}$/.test(document.getElementById('zip').value),'zip','zip-err','sec12');
  add(document.getElementById('sqft-val').value.trim(),'sqft-val','sqft-val-err','sec12');
  // Account
  add(document.getElementById('fullname').value.trim(),'fullname','name-err','sec14');
  add(document.getElementById('phone').value.replace(/\D/g,'').length===10,'phone','phone-err','sec14');
  // Video format
  if(S.vvt&&!document.getElementById('vvt-fmt').value){
    document.getElementById('vvt-fmt').classList.add('err');document.getElementById('vvt-fmt-err').classList.add('show');
    errs.push(document.getElementById('vvt-fmt'));
  } else {document.getElementById('vvt-fmt').classList.remove('err');document.getElementById('vvt-fmt-err').classList.remove('show');}
  // Property details
  add(document.getElementById('access').value,'access','access-err','sec15');
  add(document.getElementById('vacancy').value,'vacancy','vacancy-err','sec15');
  const shootSame=document.getElementById('shoot-same-phone').checked;
  if(!shootSame) add(document.getElementById('shoot-contact').value.replace(/\D/g,'').length===10,'shoot-contact','shoot-err','sec15');
  // Terms
  if(!S.terms){document.getElementById('terms-err').classList.add('show');errs.push(document.getElementById('terms-cb'));}
  else{document.getElementById('terms-err').classList.remove('show');}
  return errs.filter(Boolean);
}

