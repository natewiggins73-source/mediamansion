        <div class="pkg-check"></div>
        <div class="pkg-tag" style="background:#5c6b73">Essential Scan</div>
        <img src="https://static.showit.com/file/GGDgT_jvOXvOaX3xmxOHbw/273321/dollhouse-view_3.jpg" alt="Essential Scan Package" class="pkg-img" draggable="false">
        <div class="pkg-price" id="pkg-escan-price">$230</div>
        <ul class="pkg-list"><li>3D Matterport Scan</li><li class="pkg-note">Active 90 days — $20/month after</li><li>5 Exterior 360s</li><li>Delivered in 24–48 Hrs</li></ul>
        <button class="pkg-clear" id="clear-escan">Clear</button>
      </div>
      <div class="pkg-card" id="pkg-signature" tabindex="0" role="button" aria-pressed="false">
        <div class="pkg-check"></div>
        <div class="pkg-tag" style="background:#3d6491">Premier Combo</div>
